    {
      "type": "object",
      "required": ["entityType", "projectId", "statement", "businessBasis", "requirementIds"],
      "properties": {
        "entityType": { "const": "outcome-obligation" },
        "projectId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "statement": { "type": "string", "minLength": 1 },
        "businessBasis": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
