{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/authorization-boundary.schema.json",
  "title": "Authorization boundary",
  "allOf": [
    { "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "projectId",
        "outcomeId",
        "name",
        "subjectIds",
        "externalBoundaryIds",
        "scopeStatement"
      ],
      "properties": {
        "entityType": { "const": "authorization-boundary" },
        "projectId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "outcomeId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "name": { "type": "string", "minLength": 1 },
        "subjectIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "externalBoundaryIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scopeStatement": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "unevaluatedProperties": false
}
