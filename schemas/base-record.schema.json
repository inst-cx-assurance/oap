{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/base-record.schema.json",
  "title": "OAP versioned record",
  "type": "object",
  "required": ["id", "entityType", "recordVersion", "createdAt"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "entityType": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "recordVersion": { "$ref": "#/$defs/version" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "supersedes": { "$ref": "#/$defs/id" },
    "createdByPartyId": { "$ref": "#/$defs/id" },
    "generationMethod": { "enum": ["human_supplied", "system_capture"] },
    "qualifications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(oap|[a-z][a-z0-9.-]*):[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "idArray": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "nonEmptyIdArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "hash": {
      "oneOf": [
        {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha512" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{128}$" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
