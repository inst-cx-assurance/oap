{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/controlled-explanation.schema.json",
  "title": "Controlled validation explanation",
  "allOf": [
    { "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "subjectRecordId",
        "diagnosticCodes",
        "supportingRecordIds",
        "narrative"
      ],
      "properties": {
        "entityType": { "const": "controlled-explanation" },
        "subjectRecordId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "diagnosticCodes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "supportingRecordIds": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "narrative": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "unevaluatedProperties": false
}
