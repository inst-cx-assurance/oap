{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/authorization-change.schema.json",
  "title": "Authorization withdrawal, revocation, expiry or reassessment trigger",
  "allOf": [
    { "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "projectId",
        "outcomeId",
        "boundaryIds",
        "authorizationId",
        "actorType",
        "changedAt",
        "changeType",
        "basis",
        "generationMethod"
      ],
      "properties": {
        "entityType": { "const": "authorization-change" },
        "projectId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "outcomeId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "boundaryIds": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/nonEmptyIdArray"
        },
        "authorizationId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "changedByRoleAssignmentId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "actorType": { "enum": ["human_authority", "system_detection"] },
        "changedAt": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "changeType": {
          "enum": ["withdrawn", "revoked", "expired", "superseded", "reassessment_required"]
        },
        "basis": { "type": "string", "minLength": 1 },
        "replacementAuthorizationId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "changeType": { "enum": ["withdrawn", "revoked", "superseded"] } }
          },
          "then": {
            "properties": {
              "actorType": { "const": "human_authority" },
              "generationMethod": { "const": "human_supplied" }
            },
            "required": ["changedByRoleAssignmentId"]
          }
        },
        {
          "if": { "properties": { "actorType": { "const": "human_authority" } } },
          "then": { "required": ["changedByRoleAssignmentId"] }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
