{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/outcome-requirement.schema.json",
  "title": "Outcome Requirement",
  "allOf": [
    { "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": ["entityType", "obligationId", "outcomeId", "statement", "criterionIds"],
      "properties": {
        "entityType": { "const": "outcome-requirement" },
        "obligationId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "outcomeId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "statement": { "type": "string", "minLength": 1 },
        "criterionIds": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
