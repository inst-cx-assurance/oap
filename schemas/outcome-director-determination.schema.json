{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/outcome-director-determination.schema.json",
  "title": "Human Outcome Director determination",
  "allOf": [
    { "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "projectId",
        "outcomeId",
        "boundaryIds",
        "auditorEvaluationId",
        "directorRoleAssignmentId",
        "determinedAt",
        "determination",
        "evidenceBasisIds",
        "residualRiskDeclarationId",
        "rationale",
        "generationMethod"
      ],
      "properties": {
        "entityType": { "const": "outcome-director-determination" },
        "projectId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "outcomeId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "boundaryIds": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "auditorEvaluationId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "directorRoleAssignmentId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "determinedAt": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "determination": {
          "enum": ["supports_authorization", "does_not_support_authorization", "deferred"]
        },
        "evidenceBasisIds": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "residualRiskDeclarationId": {
          "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "unevaluatedProperties": false
}
