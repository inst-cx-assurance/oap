{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.oap.example/v0.1/schemas/project-context.schema.json",
  "title": "Project and assurance context",
  "allOf": [
    { "$ref": "https://spec.oap.example/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": ["entityType", "name", "lifecycleContext"],
      "properties": {
        "entityType": { "const": "project-context" },
        "name": { "type": "string", "minLength": 1 },
        "lifecycleContext": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "unevaluatedProperties": false
}
